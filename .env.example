# Supabase — get these from https://supabase.com/dashboard/project/kqmvwefcnfsrplyedjsr/settings/api
#
# NEXT_PUBLIC_* is not a suggestion. Next.js text-substitutes these values into
# the client bundle at build time, so anyone can read them out of the shipped
# app. Only ever put values here that are safe to be public. The anon key is
# safe to expose — Row Level Security in Postgres is what actually protects
# your data.

NEXT_PUBLIC_SUPABASE_URL=https://kqmvwefcnfsrplyedjsr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
